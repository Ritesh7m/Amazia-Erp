# Google Sheets API Credentials
GOOGLE_CLIENT_EMAIL="inventory-sync-bot@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
GOOGLE_SPREADSHEET_ID="your_spreadsheet_id"

# Security for Sync Endpoints
CRON_SECRET="your_cron_secret"

# Backup Service Configuration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://developers.google.com/oauthplayground"
GOOGLE_REFRESH_TOKEN="your_refresh_token"
GOOGLE_DRIVE_BACKUP_FOLDER_ID="your_backup_folder_id"

LOCAL_BACKUP_DIR="./backups"
DATABASE_DIR="./database"
BACKUP_CRON_SCHEDULE="0 11 * * *"
RETENTION_DAYS="7"
MAX_UPLOAD_RETRIES="3"

# Real Shipment API Credentials
SHIPMENT_API_BASE_URL=http://your-shipment-api-host:4000
SHIPMENT_API_USERNAME=your_username
SHIPMENT_API_PASSWORD=your_password